<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>INSwitch</RootNamespace>
    <AssemblyName>NN Switch</AssemblyName>
    <Product>NN Switch</Product>
    <Description>A lightweight keyboard layout switcher for Windows.</Description>
    <Authors>Philippsapegin</Authors>
    <VersionPrefix>1.3.1</VersionPrefix>
    <RepositoryUrl>https://github.com/Philippsapegin/NNSwitch</RepositoryUrl>
    <ApplicationIcon>NN.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

</Project>
